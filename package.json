{
  "name": "github-pr-review-bot",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "start": "node src/index.js",
    "build": "ncc build src/index.js --license licenses.txt",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/varunn15/github-pr-review-bot.git"
  },
  "keywords": [
    "github-action",
    "pr-review",
    "gemini",
    "ai",
    "code-review",
    "automation"
  ],
  "author": "varunn15",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/varunn15/github-pr-review-bot/issues"
  },
  "homepage": "https://github.com/varunn15/github-pr-review-bot#readme",
  "description": "GitHub Action that reviews PRs using Google Gemini AI",
  "dependencies": {
    "@google/genai": "^2.17.0",
    "@octokit/rest": "^22.0.1",
    "dotenv": "^16.0.0"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.38.4",
    "jest": "^30.4.2"
  },
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/index.js",
      "!**/node_modules/**"
    ]
  }
}